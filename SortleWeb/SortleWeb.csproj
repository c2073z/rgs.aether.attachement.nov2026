<!--
  SORTLE WEBSITE  -  SortleWeb.csproj   (built by the AI agent)
  The build recipe: "this is a Blazor website on .NET 8".
  It pulls in the students' two files straight from ../StudentWork,
  so there is only ever ONE copy of Yuhan's and Siqing's code.
-->
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SortleWeb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The students' game engine: BubbleSorter.cs (Yuhan) and ScoreKeeper.cs (Siqing). -->
    <Compile Include="../StudentWork/*.cs" Link="StudentWork/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
